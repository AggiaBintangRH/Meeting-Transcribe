*.safetensors

# Whisper cache
.whisper/

# Build
build/
dist/
*.egg-info/
/.build-cache
/.claude
/.venv-dicow
# The NeMo diarization runtime — 1.7 GB, rebuilt by download-best-models.sh 3c.
# Listed beside .venv-dicow because `.venv/` above does NOT cover it: that
# pattern is an exact directory name, not a prefix.
/.venv-nemo
# The DiariZen runtime — 1.5 GB, and the ONLY one on Python 3.11 (torch 2.1.1
# has no 3.12 wheels). Same reason it needs its own line: `.venv/` above is an
# exact directory name, not a prefix, so this was untracked-but-not-ignored and
# a `git add -A` would have committed all 1.5 GB.
/.venv-diarizen

# Exported meeting transcripts. Real client speech, written here by the owner
# choosing this folder in the export dialog — the one category in this repo that
# must never reach a remote.
/PDFExport

# Secrets — never commit. Use .env.example as the template.
.env

# Private data: real meeting audio, transcripts, and sidecar logs.
# This project's whole premise is that recordings never leave the machine.
recordings/
logs/

# Built app bundle (multi-GB, rebuild with build.sh)
*.app/
/.build-cache

# SwiftPM build artifacts (swift build regenerates these)
.build/

# macOS cruft
.DS_Store

# Internal notes (CLAUDE.md, SESSION-HANDOFF.md, PLAN*.md) stay local —
# but the README is the repo's front page, so it ships.
*.md
!README.md

# numba JIT cache. `PythonRuntime.sidecarEnvironment` points NUMBA_CACHE_DIR here
# (dataDir = the project root in dev mode, Application Support when bundled), so
# it appears the moment any librosa-importing sidecar runs. Ignored for the same
# reason /.venv-nemo is: it was untracked-but-not-ignored, and one `git add -A`
# committed 46 files of it on 2026-08-13 (7806f274d).
/numba-cache

# The VibeVoice runtime — transformers <5.0, a hard conflict with the MLX stack
# in the main .venv (which needs 5.x). Same reason .venv-dicow exists. Listed
# explicitly because `.venv/` above is an exact directory name, not a prefix.
/.venv-vibevoice
